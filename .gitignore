# ============================================
# Honeypot Platform — .gitignore
# ============================================
# Add patterns here for files that must NEVER be committed to GitHub.
# See docs/DEPLOYMENT_GUIDE.md for more info.

# 🔴 ENVIRONMENT VARIABLES (CRITICAL — contains passwords & API keys)
.env
.env.*
!.env.example

# 🔴 RUNTIME DATA (session logs, PCAPs, IOCs — contains attacker IPs + data)
data/
logs/
captures/
sessions/
iocs/
pcaps/

# Packet captures & logs
*.log
*.log.*
*.pcap
*.pcapng

# Python bytecode & cache
__pycache__/
**/__pycache__/
*.pyc
*.py[cod]
*$py.class

# Virtual environments (never commit these!)
venv/
.venv/
env/

# Build / distribution
build/
dist/
*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE / editor files (personal preferences)
.vscode/
.idea/
*.swp
*.swo
*~

# OS junk (only matters on your local machine)
.DS_Store
Thumbs.db
Desktop.ini

# Docker
.dockerignore

# Temporary files
*.tmp
*.bak
*.backup

# Database files (local development only)
*.db
*.sqlite

# SSH keys / certificates
*.pem
*.key
*.cert
*.crt

# Supabase sync state (generated at runtime on EC2)
/tmp/honeypot_sync_state.json
